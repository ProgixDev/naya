# Demo API
PORT=4010
NAYA_DEV=1                      # enables /dev routes, fixed OTP 123456, scenario launcher. Set 0 in production.
NAYA_PROVIDER_SECRET=demo-provider-secret-change-me   # HMAC secret for provider callbacks (required when NAYA_DEV=0)
# NAYA_DATA_DIR=./services/demo-api/.data
# NAYA_APPLE_AUTH_CONFIGURED=1  # only once server-side Apple token verification exists
# NAYA_GOOGLE_AUTH_CONFIGURED=1

# Mobile apps (Expo public env)
EXPO_PUBLIC_API_URL=http://localhost:4010
EXPO_PUBLIC_DEMO=1
# Native demo is standalone by default. Set 0 only for a shared server/admin demo.
EXPO_PUBLIC_STANDALONE=1
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# GOOGLE_MAPS_ANDROID_KEY=      # build-time; without it Android uses the tile fallback

# Admin
VITE_API_URL=http://localhost:4010
